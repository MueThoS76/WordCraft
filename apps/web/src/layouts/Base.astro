---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        line-height: 1.6;
        color: #1a1a1a;
      }
      .site-header {
        border-bottom: 1px solid #e5e5e5;
      }
      .site-header nav,
      main.site-main {
        max-width: 720px;
        margin: 0 auto;
        padding: 1rem 1.25rem;
      }
      .site-header a {
        margin-right: 1rem;
        color: inherit;
        text-decoration: none;
        font-weight: 600;
      }
      main.site-main img {
        max-width: 100%;
        height: auto;
      }
      .post-meta {
        color: #666;
        font-size: 0.9rem;
      }
      .post-list {
        list-style: none;
        padding: 0;
      }
      .post-list li {
        margin-bottom: 2rem;
      }
      .post-list h2 {
        margin: 0 0 0.25rem;
      }
      .post-list h2 a {
        color: inherit;
        text-decoration: none;
      }
      .category-chip {
        display: inline-block;
        margin-right: 0.4rem;
        padding: 0 0.5rem;
        border-radius: 999px;
        background: #eef2ff;
        color: #3730a3;
        font-size: 0.8rem;
        text-decoration: none;
      }
      .pager {
        display: flex;
        justify-content: space-between;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href="/">Start</a>
        <a href="/blog">Blog</a>
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
  </body>
</html>
