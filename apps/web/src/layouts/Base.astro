---
import { fetchSettings } from "../lib/api";

interface Props {
  title: string;
  /** Startseite: zeigt nur den Seitentitel statt "Titel – Seitentitel". */
  isHome?: boolean;
}
const { title, isHome = false } = Astro.props;
const settings = await fetchSettings();
const pageTitle = isHome ? settings.siteTitle : `${title} – ${settings.siteTitle}`;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <style is:global>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        line-height: 1.6;
        color: #1a1a1a;
      }
      .site-header {
        border-bottom: 1px solid #e5e5e5;
      }
      .site-header nav,
      main.site-main {
        max-width: 720px;
        margin: 0 auto;
        padding: 1rem 1.25rem;
      }
      .site-header a {
        margin-right: 1rem;
        color: inherit;
        text-decoration: none;
        font-weight: 600;
      }
      main.site-main img {
        max-width: 100%;
        height: auto;
      }
      .site-title {
        font-size: 1.15rem;
      }
      .site-tagline {
        max-width: 720px;
        margin: -0.5rem auto 0;
        padding: 0 1.25rem 0.75rem;
        color: #666;
        font-size: 0.9rem;
      }
      .site-footer {
        max-width: 720px;
        margin: 2rem auto 0;
        padding: 1rem 1.25rem;
        border-top: 1px solid #e5e5e5;
        color: #666;
        font-size: 0.9rem;
      }
      blockquote {
        margin: 1.5rem 0;
        padding: 0.25rem 1rem;
        border-left: 4px solid #c7d2fe;
        color: #374151;
      }
      blockquote footer {
        color: #666;
        font-size: 0.9rem;
      }
      hr {
        border: 0;
        border-top: 1px solid #e5e5e5;
        margin: 2rem 0;
      }
      .pc-button {
        display: inline-block;
        padding: 0.5rem 1.1rem;
        border-radius: 6px;
        border: 2px solid #4f46e5;
        text-decoration: none;
        font-weight: 600;
      }
      .pc-button-primary {
        background: #4f46e5;
        color: #fff;
      }
      .pc-button-outline {
        background: transparent;
        color: #4f46e5;
      }
      .post-meta {
        color: #666;
        font-size: 0.9rem;
      }
      .post-list {
        list-style: none;
        padding: 0;
      }
      .post-list li {
        margin-bottom: 2rem;
      }
      .post-list h2 {
        margin: 0 0 0.25rem;
      }
      .post-list h2 a {
        color: inherit;
        text-decoration: none;
      }
      .category-chip {
        display: inline-block;
        margin-right: 0.4rem;
        padding: 0 0.5rem;
        border-radius: 999px;
        background: #eef2ff;
        color: #3730a3;
        font-size: 0.8rem;
        text-decoration: none;
      }
      .pager {
        display: flex;
        justify-content: space-between;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a class="site-title" href="/">{settings.siteTitle}</a>
        {settings.navigation.map((item) => <a href={item.url}>{item.label}</a>)}
      </nav>
      {settings.tagline && <p class="site-tagline">{settings.tagline}</p>}
    </header>
    <main class="site-main">
      <slot />
    </main>
    {settings.footerText && <footer class="site-footer">{settings.footerText}</footer>}
  </body>
</html>
