---
import { parseTheme, themeToCss } from "@presscraft/theme-sdk";
import { fetchSettings } from "../lib/api";

interface Props {
  title: string;
  /** Startseite: zeigt nur den Seitentitel statt "Titel – Seitentitel". */
  isHome?: boolean;
  /** Meta-Beschreibung für Suchmaschinen und Link-Vorschauen. */
  description?: string;
}
const { title, isHome = false, description } = Astro.props;
const settings = await fetchSettings();
const theme = parseTheme(settings.theme);
// themeToCss gibt nur validierte Werte aus (Hex-Farben, feste Schriftliste,
// Zahlenbereiche) — kein Weg, beliebiges CSS einzuschleusen.
const themeCss = themeToCss(theme);
const pageTitle = isHome ? settings.siteTitle : `${title} – ${settings.siteTitle}`;
const metaDescription = description || settings.tagline;
const headerClass = theme.layout.headerStyle === "centered" ? "header-centered" : "";
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <meta property="og:title" content={pageTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:site_name" content={settings.siteTitle} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={settings.siteTitle}
      href="/feed.xml"
    />
    <style set:html={themeCss}></style>
    <style is:global>
      body {
        margin: 0;
        font-family: var(--pc-font);
        font-size: var(--pc-font-size);
        line-height: var(--pc-line-height);
        color: var(--pc-text);
        background: var(--pc-bg);
      }
      a {
        color: var(--pc-primary);
      }
      .site-header {
        border-bottom: 1px solid var(--pc-border);
      }
      .site-header nav,
      main.site-main {
        max-width: var(--pc-content-width);
        margin: 0 auto;
        padding: 1rem 1.25rem;
      }
      .site-header a {
        margin-right: 1rem;
        color: inherit;
        text-decoration: none;
        font-weight: 600;
      }
      .site-header.header-centered nav {
        text-align: center;
      }
      .site-header.header-centered .site-tagline {
        text-align: center;
      }
      .site-title {
        font-size: 1.15rem;
      }
      .site-search {
        display: inline-block;
        margin-left: 1rem;
      }
      .site-search input {
        padding: 0.25rem 0.6rem;
        border: 1px solid var(--pc-border);
        border-radius: var(--pc-radius);
        background: var(--pc-bg);
        color: var(--pc-text);
        font: inherit;
        font-size: 0.9rem;
        width: 9rem;
      }
      .site-tagline {
        max-width: var(--pc-content-width);
        margin: -0.5rem auto 0;
        padding: 0 1.25rem 0.75rem;
        color: var(--pc-muted);
        font-size: 0.9rem;
      }
      .site-footer {
        max-width: var(--pc-content-width);
        margin: 2rem auto 0;
        padding: 1rem 1.25rem;
        border-top: 1px solid var(--pc-border);
        color: var(--pc-muted);
        font-size: 0.9rem;
      }
      main.site-main img {
        max-width: 100%;
        height: auto;
        border-radius: var(--pc-radius);
      }
      blockquote {
        margin: 1.5rem 0;
        padding: 0.25rem 1rem;
        border-left: 4px solid var(--pc-primary);
        background: var(--pc-surface);
        border-radius: 0 var(--pc-radius) var(--pc-radius) 0;
      }
      blockquote footer {
        color: var(--pc-muted);
        font-size: 0.9rem;
      }
      hr {
        border: 0;
        border-top: 1px solid var(--pc-border);
        margin: 2rem 0;
      }
      .pc-button {
        display: inline-block;
        padding: 0.5rem 1.1rem;
        border-radius: var(--pc-radius);
        border: 2px solid var(--pc-primary);
        text-decoration: none;
        font-weight: 600;
      }
      .pc-button-primary {
        background: var(--pc-primary);
        color: var(--pc-bg);
      }
      .pc-button-outline {
        background: transparent;
        color: var(--pc-primary);
      }
      .post-meta {
        color: var(--pc-muted);
        font-size: 0.9rem;
      }
      .post-list {
        list-style: none;
        padding: 0;
      }
      .post-list li {
        margin-bottom: 2rem;
      }
      .post-list h2 {
        margin: 0 0 0.25rem;
      }
      .post-list h2 a {
        color: inherit;
        text-decoration: none;
      }
      .category-chip {
        display: inline-block;
        margin-right: 0.4rem;
        padding: 0 0.5rem;
        border-radius: 999px;
        background: var(--pc-surface);
        color: var(--pc-primary);
        font-size: 0.8rem;
        text-decoration: none;
      }
      .pager {
        display: flex;
        justify-content: space-between;
      }
    </style>
  </head>
  <body>
    <header class={`site-header ${headerClass}`}>
      <nav>
        <a class="site-title" href="/">{settings.siteTitle}</a>
        {settings.navigation.map((item) => <a href={item.url}>{item.label}</a>)}
        <form class="site-search" action="/suche" method="get" role="search">
          <input type="search" name="q" placeholder="Suchen …" aria-label="Suchen" maxlength="100" />
        </form>
      </nav>
      {settings.tagline && <p class="site-tagline">{settings.tagline}</p>}
    </header>
    <main class="site-main">
      <slot />
    </main>
    {settings.footerText && <footer class="site-footer">{settings.footerText}</footer>}
  </body>
</html>
