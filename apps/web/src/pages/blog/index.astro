---
import PostListView from "../../components/PostListView.astro";
import Base from "../../layouts/Base.astro";
import { fetchCategories, fetchPosts, parsePage } from "../../lib/api";

const page = parsePage(Astro.url.searchParams.get("seite"));
const [list, categories] = await Promise.all([fetchPosts({ page }), fetchCategories()]);
---

<Base title="Blog">
  <h1>Blog</h1>
  {
    categories.length > 0 && (
      <p>
        {categories.map((category) => (
          <a class="category-chip" href={`/kategorie/${category.slug}`}>
            {category.name} ({category.itemCount})
          </a>
        ))}
      </p>
    )
  }
  <PostListView list={list} page={page} basePath="/blog" />
</Base>
