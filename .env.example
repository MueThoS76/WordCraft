DATABASE_URL=postgresql://presscraft:presscraft@localhost:5433/presscraft

# NUR FÜR ENTWICKLUNG/AUTOMATISIERUNG: Ist ADMIN_PASSWORD gesetzt, legt der Server
# diesen Admin beim Start an. Ohne diese Variable gibt es bewusst keinen Standard-
# Admin — dann erscheint beim ersten Aufruf von /admin der Einrichtungsassistent.
#
# Erster Admin-Account, den der BootstrapService anlegt, falls er noch nicht
# existiert (siehe docs/decisions/0015-implementierungsplan-meilenstein-1.md,
# Schritt 7). Kein echter Einrichtungsassistent — vor produktivem Einsatz
# unbedingt ein eigenes Passwort setzen.
ADMIN_EMAIL=admin@presscraft.local
ADMIN_PASSWORD=presscraft-dev

# Origin von apps/admin, der per CORS mit Cookies zugreifen darf (Schritt 8).
ADMIN_ORIGIN=http://localhost:4322

# Medien: Speicherort der Uploads (Standard: apps/server/uploads) und öffentliche
# Basis-URL für Datei-Links (Standard: Host der Anfrage).
# MEDIA_DIR=./uploads
# PUBLIC_URL=http://localhost:3000

# Öffentliche Basis-URL der Website für Feed und Sitemap (Standard: Host der Anfrage).
# SITE_URL=http://localhost:4321
